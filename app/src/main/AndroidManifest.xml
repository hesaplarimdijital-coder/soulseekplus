<?xml version="1.0" encoding="utf-8"?>
<!-- LEAD — sözleşme dosyası. Bileşen adları docs/ARCHITECTURE.md dosya sahipliği tablosuyla eşleşir. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soulseek sunucusu ve eşler. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi/mobil geçişini algılayıp soketi kurtarmak ve ölçülü bağlantıyı bilmek için. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ekran kapalıyken Wi-Fi'nin güç tasarrufuna geçip transferi kesmemesi (WifiLock) + UPnP SSDP çoklu yayını. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Ön plan servisi: bağlantı ve transferler arka planda sürsün. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Aktif transfer sırasında CPU uyumasın (kısmi wake lock). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- API 33+: özel mesaj, istek listesi ve transfer bildirimleri. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- USB OTG belleklere SAF ile indirme (zorunlu değil). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:name=".SoulseekApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.SoulseekPlus">

        <!-- resizeableActivity + configChanges: DeX'te pencere boyutlanınca etkinlik yeniden oluşturulmaz
             (desktop-kit kabuğu durumunu korur). singleTask: slsk:// bağlantısı ikinci örnek açmaz. -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- slsk://kullanici/yol/dosya bağlantıları (Nicotine+ biçimi). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="slsk" />
            </intent-filter>
            <!-- Başka uygulamadan paylaşılan metni (ör. albüm adı) aramaya aç. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SoulseekService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
